FROM mcr.microsoft.com/dotnet/aspnet:10.0

ARG PUBLISH_DIR
ARG ENTRY_FILE
ARG RUNTIME_ENVIRONMENT=Production

ENV entry_point="${ENTRY_FILE}"
ENV ASPNETCORE_ENVIRONMENT="${RUNTIME_ENVIRONMENT}"
ENV DOTNET_ENVIRONMENT="${RUNTIME_ENVIRONMENT}"

COPY $PUBLISH_DIR/ /app/
WORKDIR /app
ENTRYPOINT dotnet "${entry_point}"