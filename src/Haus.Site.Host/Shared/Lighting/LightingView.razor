@using System.Reactive.Linq
@using System.Reactive.Subjects
@using Haus.Core.Models.Lighting
@implements IDisposable

@if (CurrentLighting == null)
{
    <MudText Typo="Typo.h3">no lighting available</MudText>
}
else
{
    <MudGrid>
        <MudItem>
            <MudText Typo="Typo.h5">Room Lighting</MudText>
        </MudItem>
        <MudItem xs="12">
            <MudSwitch T="bool"
                       Disabled="Disabled"
                       Value="CurrentLighting.State == LightingState.On"
                       ValueChanged="HandleStateChanged">
                State (@CurrentLighting.State)
            </MudSwitch>
        </MudItem>
        <MudItem xs="12">
            <MudSlider T="double"
                       Disabled="Disabled"
                       Min="CurrentLighting.Level.Min"
                       Value="CurrentLighting.Level.Value"
                       Max="CurrentLighting.Level.Max"
                       UserAttributes="@CreateSliderAttributes("level")"
                       ValueChanged="HandleLevelChanged">
                Level (@CurrentLighting.Level.Value %)
            </MudSlider>
        </MudItem>
        <MudItem xs="12">
            @if (CurrentLighting.Temperature != null)
            {
                <MudSlider T="double"
                           Disabled="Disabled"
                           Min="CurrentLighting.Temperature.Min"
                           Value="CurrentLighting.Temperature.Value"
                           Max="CurrentLighting.Temperature.Max"
                           UserAttributes="@CreateSliderAttributes("temperature")"
                           ValueChanged="HandleTemperatureChanged">
                    Temperature (@CurrentLighting.Temperature.Value K)
                </MudSlider>
            }
        </MudItem>
        <MudItem xs="12">
            @if (CurrentLighting.Color != null)
            {
                <MudGrid Class="mt-8 mb-16">
                    <MudItem xs="2">
                        <MudSlider T="byte"
                                   Disabled="Disabled"
                                   Min="0"
                                   Value="CurrentLighting.Color.Red"
                                   Max="255"
                                   UserAttributes="@CreateSliderAttributes("red")"
                                   Immediate="true"
                                   Vertical="@true"
                                   ValueChanged="HandleRedChanged">
                            Red (@CurrentLighting.Color.Red.ToHex())
                        </MudSlider>
                    </MudItem>
                    <MudItem xs="2">
                        <MudSlider T="byte"
                                   Disabled="Disabled"
                                   Min="0"
                                   Value="CurrentLighting.Color.Green"
                                   Max="255"
                                   Immediate="true"
                                   UserAttributes="@CreateSliderAttributes("green")"
                                   Vertical="@true"
                                   ValueChanged="HandleGreenChanged">
                            Green (@CurrentLighting.Color.Green.ToHex())
                        </MudSlider>
                    </MudItem>
                    <MudItem xs="2">
                        <MudSlider T="byte"
                                   Disabled="Disabled"
                                   Min="0"
                                   Value="CurrentLighting.Color.Blue"
                                   Max="255"
                                   Immediate="true"
                                   UserAttributes="@CreateSliderAttributes("blue")"
                                   Vertical="true"
                                   ValueChanged="HandleBlueChanged">
                            Blue (@CurrentLighting.Color.Blue.ToHex())
                        </MudSlider>
                    </MudItem>
                    <MudItem xs="2">
                        <MudPaper Class="pa-16" Style="@($"background-color: {CurrentLighting.Color.ToHex()}")" />
                        <MudText>
                            @CurrentLighting.Color.ToHex()
                        </MudText>
                    </MudItem>
                </MudGrid>
            }
        </MudItem>
    </MudGrid>
}

@code {
    private BehaviorSubject<LightingModel?> _lightingSubject = new(null);
    private IDisposable? _subscription;

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public LightingModel? Lighting { get; set; }

    [Parameter] public EventCallback<LightingModel> OnLightingChanged { get; set; }

    // The subject -- not the Lighting parameter itself -- is the live render source: slider drags
    // push through it via OnNext without waiting for the parent to round-trip a new parameter value,
    // so mid-drag state (and each successive drag building on the last) renders immediately.
    private LightingModel? CurrentLighting => _lightingSubject.Value;

    protected override void OnParametersSet()
    {
        ResetLightingSubject(Lighting);
    }

    private void HandleStateChanged(bool state)
    {
        ArgumentNullException.ThrowIfNull(CurrentLighting);

        _lightingSubject.OnNext(CurrentLighting with
        {
            State = state ? LightingState.On : LightingState.Off
        });
    }

    private void HandleLevelChanged(double level)
    {
        ArgumentNullException.ThrowIfNull(CurrentLighting);

        _lightingSubject.OnNext(CurrentLighting with
        {
            Level = CurrentLighting.Level with
            {
                Value = level
            }
        });
    }

    private void HandleTemperatureChanged(double temp)
    {
        ArgumentNullException.ThrowIfNull(CurrentLighting?.Temperature);

        _lightingSubject.OnNext(CurrentLighting with
        {
            Temperature = CurrentLighting.Temperature with
            {
                Value = temp
            }
        });
    }

    private void HandleRedChanged(byte red)
    {
        ArgumentNullException.ThrowIfNull(CurrentLighting?.Color);

        _lightingSubject.OnNext(CurrentLighting with
        {
            Color = CurrentLighting.Color with
            {
                Red = red
            }
        });
    }

    private void HandleGreenChanged(byte green)
    {
        ArgumentNullException.ThrowIfNull(CurrentLighting?.Color);

        _lightingSubject.OnNext(CurrentLighting with
        {
            Color = CurrentLighting.Color with
            {
                Green = green
            }
        });
    }

    private void HandleBlueChanged(byte blue)
    {
        ArgumentNullException.ThrowIfNull(CurrentLighting?.Color);

        _lightingSubject.OnNext(CurrentLighting with
        {
            Color = CurrentLighting.Color with
            {
                Blue = blue
            }
        });
    }

    private Dictionary<string, object?> CreateSliderAttributes(string id)
    {
        return new Dictionary<string, object?>
        {
            { "id", id }
        };
    }

    private void ResetLightingSubject(LightingModel? lighting)
    {
        _subscription?.Dispose();
        _lightingSubject = new BehaviorSubject<LightingModel?>(lighting);
        _subscription = _lightingSubject
            .Throttle(TimeSpan.FromMilliseconds(300))
            .Select(l => InvokeAsync(() => OnLightingChanged.InvokeAsync(l)))
            .Subscribe();
    }

    public void Dispose()
    {
        _subscription?.Dispose();
    }

}
