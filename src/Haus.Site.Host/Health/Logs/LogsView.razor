@using System.Threading
@using Haus.Api.Client.Logs
@using Haus.Core.Models.Common
@using Haus.Core.Models.Logs
@using Microsoft.Extensions.Logging

@implements IDisposable;

@inject ILogsApiClient LogsClient;
@inject ILogger<LogsView> Logger;

<MudPaper>
    <MudStack Row="true">
        <MudText Typo="Typo.h4">
            Recent Logs
        </MudText>
        @if (IsLoading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
    </MudStack>

    <MudList T="LogEntryModel">
        @foreach (var log in Logs.Items)
        {
            <MudListItem T="LogEntryModel">
                <LogEntryView LogEntry="log"/>
            </MudListItem>
        }
    </MudList>    
</MudPaper>

@code {
    private bool IsLoading { get; set; }
    private ListResult<LogEntryModel> Logs { get; set; } = new([]);
    private PeriodicTimer? Timer { get; set; }
    private Task? RefreshLoopTask { get; set; }
    private bool IsDisposed { get; set; }

    [Parameter] public TimeSpan RefreshInterval { get; set; } = TimeSpan.FromSeconds(3);

    protected override async Task OnInitializedAsync()
    {
        await RefreshLogsAsync();
        StartRefreshingLogs(RefreshInterval);
    }

    protected override void OnParametersSet()
    {
        StartRefreshingLogs(RefreshInterval);
    }

    public void Dispose()
    {
        IsDisposed = true;
        Timer?.Dispose();
    }

    private void StartRefreshingLogs(TimeSpan timeSpan)
    {
        if (IsDisposed)
        {
            return;
        }

        Timer?.Dispose();
        Timer = new PeriodicTimer(timeSpan);
        RefreshLoopTask = RefreshOnEachTickAsync(Timer);
    }

    // Each tick catches its own failure so one bad refresh can't end this task, which keeps
    // RefreshLoopTask from ever faulting -- nothing here is fire-and-forget in the unobserved
    // sense, it's just not synchronously awaited.
    private async Task RefreshOnEachTickAsync(PeriodicTimer timer)
    {
        while (await timer.WaitForNextTickAsync())
        {
            try
            {
                await RefreshLogsAsync();
            }
            catch (Exception e)
            {
                Logger.LogError(e, "Failed to refresh logs");
            }
        }
    }

    private async Task RefreshLogsAsync()
    {
        if (IsLoading)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            IsLoading = true;
            StateHasChanged();
        });

        try
        {
            var logs = await LogsClient.GetLogsAsync();
            await InvokeAsync(() =>
            {
                Logs = logs;
                StateHasChanged();
            });
        }
        finally
        {
            await InvokeAsync(() =>
            {
                IsLoading = false;
                StateHasChanged();
            });
        }
    }

}